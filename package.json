{
  "name": "study-assistant",
  "version": "1.10.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "postinstall": "cd server && npm install && cd ../client && npm install",
    "test": "npm test --prefix server && npm run lint --prefix client",
    "pretest": "npm run pretest --prefix server",
    "clean:testdata": "npm run clean:testdata --prefix server",
    "clean:testdata:legacy": "npm run clean:testdata:legacy --prefix server",
    "clean:testdata:legacy:confirm": "npm run clean:testdata:legacy:confirm --prefix server",
    "clean:testdata:all": "npm run clean:testdata:all --prefix server",
    "clean:cache": "npm run clean:cache --prefix server",
    "clean:backups": "npm run clean:backups --prefix server",
    "clean:test": "npm run clean:testdata --prefix server && npm run clean:backups --prefix server",
    "clean:all": "npm run clean:testdata --prefix server && npm run clean:cache --prefix server && npm run clean:backups --prefix server",
    "windows:doctor": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/doctor.ps1",
    "windows:setup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/setup.ps1",
    "windows:dev": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/dev.ps1",
    "windows:start": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/start.ps1",
    "windows:stop": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/windows/stop.ps1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "playwright": "^1.61.1"
  }
}
