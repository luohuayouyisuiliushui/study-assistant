{
  "name": "study-assistant-server",
  "version": "1.13.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch index.js",
    "start": "node index.js",
    "test": "node --test --test-concurrency=1 \"__tests__/*.test.js\"",
    "pretest": "npm run clean:testdata:all",
    "posttest": "npm run clean:testdata:all",
    "clean:testdata": "node scripts/clean-test-plans.js && node scripts/clean-test-trash.js && node scripts/clean-test-flags.js",
    "clean:testdata:legacy": "node scripts/clean-test-plans.js --legacy-names && node scripts/clean-test-trash.js --legacy-names",
    "clean:testdata:legacy:confirm": "node scripts/clean-test-plans.js --legacy-names --confirm && node scripts/clean-test-trash.js --legacy-names --confirm",
    "clean:testdata:all": "npm run clean:testdata && npm run clean:testdata:legacy:confirm && node scripts/clean-backups.js && node scripts/clean-cache.js",
    "clean:cache": "node scripts/clean-cache.js",
    "clean:backups": "node scripts/clean-backups.js",
    "lint": "npx oxlint",
    "check:data": "node scripts/check-data-integrity.js",
    "check:data:fix": "node scripts/check-data-integrity.js --fix"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "openai": "^6.45.0",
    "uuid": "^14.0.1"
  }
}
