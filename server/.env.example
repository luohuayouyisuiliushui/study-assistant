# OpenAI 兼容 API 配置
# 申请地址：https://platform.openai.com/api-keys
# 支持多个 Key（用逗号、空格或换行分隔），系统会自动轮询 + 故障转移，
# 从而实现「低成本 + 高质量」：多个廉价 Key 承担高频任务、多个强 Key 承担高价值任务。
OPENAI_API_KEY=your-api-key-here

# API 地址（支持 OpenAI、DeepSeek、SiliconFlow 等）
OPENAI_BASE_URL=https://api.openai.com/v1

# 模型名称
OPENAI_MODEL=your-model-name

# 服务器端口
PORT=3001

# AI 缓存调试（可选，设为 true 可查看 prompt 缓存命中情况）
# DEBUG_CACHE=true
